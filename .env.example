# Smart Factory IoT - Example Environment (Render & Aiven)

NODE_ENV=development
VITE_API_URL=http://localhost:3000/api
BACKEND_URL=http://localhost:3000
# Development (local PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_factory_iot
DATABASE_SSL_MODE=disable

# Production (managed PostgreSQL, e.g. Aiven/Render)
# DATABASE_URL=postgres://username:password@host:port/database?sslmode=require
# DATABASE_SSL_MODE=require
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\nYOUR_CA_CERT_CONTENT\n-----END CERTIFICATE-----
JWT_SECRET=dev-secret-key
PORT=3000
DEBUG=true
