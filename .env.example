# Smart Factory IoT - Example Environment (Render & Aiven)

NODE_ENV=development
# Docker Compose dashboard delegates identity/coverage to the backend containers.
# When running the Node server directly on the host use 'local'; API-only tests use 'standalone'.
BACKEND_DEPLOYMENT_MODE=compose
DASHBOARD_SERVICE_TOKEN=CHANGE_ME_SHARED_RANDOM_SERVICE_TOKEN_OF_AT_LEAST_32_BYTES
VITE_API_URL=/api
BACKEND_URL=http://localhost:3000
# Development (local PostgreSQL)
DATABASE_URL=postgres://smartfactory_local:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/smart_factory_iot
DATABASE_SSL_MODE=disable
# Local Docker Compose requires these independent secrets. Generate them with `openssl rand -hex 32`.
DATABASE_PASSWORD=CHANGE_ME_UNIQUE_LOCAL_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_DIFFERENT_LOCAL_REDIS_PASSWORD
# BaSyx test-stack database password. The AAS services bind only to loopback
# and run without OIDC only when the development override below is enabled.
BASYX_DB_PASSWORD=CHANGE_ME_UNIQUE_LOCAL_BASYX_DATABASE_PASSWORD
# Use this for running the Node server directly on the host; Compose uses its private Redis service URL.
REDIS_URL=redis://:CHANGE_ME_DIFFERENT_LOCAL_REDIS_PASSWORD@127.0.0.1:6379/0

# Production: Aiven PostgreSQL + Redis Cloud (set in the production secret manager)
# DATABASE_URL=postgres://<encoded-user>:<encoded-password>@<aiven-host>:<port>/<database>
# DATABASE_SSL_MODE=verify-full
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n<contents-of-provider-ca-certificate>\n-----END CERTIFICATE-----
# REDIS_URL=rediss://<redis-user>:<url-encoded-password>@<redis-cloud-host>:<tls-port>
# Production Redis must use TLS (rediss://); never use a local redis:// URL in production.
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
PORT=3000
DEBUG=true
ENABLE_DEMO_ACCOUNTS=true
ENABLE_DEMO_DATA=true
# Backend-only bearer token used by the .NET telemetry service when forwarding normalized readings.
INGESTION_API_TOKEN=CHANGE_ME_GENERATE_A_SEPARATE_RANDOM_SERVICE_TOKEN
# Private service names for Docker Compose. If running the Node API directly on
# the host, override these with the corresponding 127.0.0.1 host ports.
AAS_REPOSITORY_URL=http://aas-repository:8081
AAS_SUBMODEL_REPOSITORY_URL=http://submodel-repository:8083
AAS_CONCEPT_DESCRIPTION_REPOSITORY_URL=http://concept-description-repository:8085
AAS_REGISTRY_URL=http://aas-registry:8082
AAS_SUBMODEL_REGISTRY_URL=http://submodel-registry:8084
AASX_FILE_SERVER_URL=http://aasx-file-server:8086
AAS_ALLOW_UNAUTHENTICATED_LOCAL=true
# Configure either the OAuth token endpoint directly or an OIDC discovery URL.
# These remain blank for the local BaSyx profile; never put client secrets here.
AAS_OIDC_TOKEN_URL=
AAS_OIDC_DISCOVERY_URL=
AAS_OIDC_SCOPE=
AAS_OIDC_CLIENT_ID=
AAS_OIDC_CLIENT_SECRET=
# Production asset POST/PUT calls use the private .NET AAS provisioner.
AAS_PROVISIONING_API_URL=http://device-service:8080/api/assets
AAS_PROVISIONING_TOKEN=CHANGE_ME_SEPARATE_32_BYTE_PROVISIONING_SERVICE_TOKEN
# Exact browser origin(s); use comma-separated origins when the UI and API have different hosts.
ALLOWED_ORIGIN=http://localhost:5173
# Optional. Leave empty unless behind a reverse proxy; set trusted IP/CIDR ranges, not `*`.
TRUST_PROXY=

# Smart Factory Assistant. These values stay on the server and are never VITE_ variables.
# Gemini is tried first; the Groq-compatible endpoint is used if Gemini is missing or unavailable.
ASSISTANT_PROVIDER=openai_compatible
ASSISTANT_INCLUDE_LIVE_CONTEXT=true
ASSISTANT_GEMINI_MODEL=gemini-3.8-flash
ASSISTANT_GEMINI_FALLBACK_MODEL=gemini-2.5-flash
ASSISTANT_GEMINI_MODEL_CANDIDATES=gemini-3.8-flash,gemini-2.5-flash
ASSISTANT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ASSISTANT_GEMINI_API_KEY=

# Groq current production models. Legacy ASSISTANT_GROK_* keys are accepted for migration only.
ASSISTANT_GROQ_MODEL=openai/gpt-oss-120b
ASSISTANT_GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
ASSISTANT_GROQ_MODEL_CANDIDATES=openai/gpt-oss-120b,openai/gpt-oss-20b
ASSISTANT_GROQ_BASE_URL=https://api.groq.com/openai/v1
ASSISTANT_GROQ_API_KEY=
