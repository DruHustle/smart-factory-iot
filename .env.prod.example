# Vercel frontend production template.
# Add only browser-safe VITE_* variables to Vercel Project Settings.
# Keep backend, database, authentication, broker, and service credentials on Render.
VITE_API_URL=/api

# Optional: this value is embedded in browser JavaScript. Restrict the key to the
# production web origin and only the required Google Maps APIs.
VITE_GOOGLE_MAPS_API_KEY=CHANGE_ME_OPTIONAL_BROWSER_RESTRICTED_KEY
